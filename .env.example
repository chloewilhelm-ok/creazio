# Modèle des variables d'environnement (copier en .env et remplir). Ne jamais committer .env.
# Clé PUBLIQUE uniquement côté navigateur (sb_publishable_… ou JWT « anon ») ; la clé secrète
# (sb_secret_… / service_role) ne va jamais ici : elle reste dans les secrets Supabase.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
